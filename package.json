{
  "name": "@urthr-products/cell-ui",
  "version": "0.1.0",
  "description": "Excel-like spreadsheet UI for the web: Excel clipboard interop, keyboard shortcuts, cell styling, and a plugin API.",
  "type": "module",
  "main": "./dist/cell-ui.js",
  "module": "./dist/cell-ui.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cell-ui.iife.js",
  "jsdelivr": "./dist/cell-ui.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cell-ui.js",
      "default": "./dist/cell-ui.js"
    },
    "./style.css": "./dist/cell-ui.css",
    "./iife": "./dist/cell-ui.iife.js"
  },
  "sideEffects": [
    "./dist/cell-ui.css",
    "./src/styles.css",
    "./src/index.ts"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs"
  },
  "keywords": [
    "spreadsheet",
    "excel",
    "grid",
    "table",
    "typescript",
    "web-component",
    "clipboard"
  ],
  "author": "urthr products",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urthr-products/cell-ui.git"
  },
  "bugs": {
    "url": "https://github.com/urthr-products/cell-ui/issues"
  },
  "homepage": "https://github.com/urthr-products/cell-ui#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
